{
	"name": "frappe-builder-extension-sdk",
	"version": "0.1.4",
	"description": "The package an extension author installs. The runtime half is served by Builder.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frappe/builder.git",
		"directory": "frontend/extension-sdk"
	},
	"type": "module",
	"files": [
		"dist",
		"src",
		"vite.js",
		"README.md"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./vue": {
			"source": "./src/vue.ts",
			"types": "./dist/vue.d.ts",
			"default": "./dist/vue.js"
		},
		"./vite": "./vite.js",
		"./types": {
			"source": "./src/shared/types.ts",
			"types": "./dist/shared/types.d.ts",
			"default": "./dist/types.js"
		},
		"./transport": {
			"source": "./src/shared/transport/createPortChannel.ts",
			"types": "./dist/shared/transport/createPortChannel.d.ts",
			"default": "./dist/transport/createPortChannel.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"prepare": "npm run build"
	},
	"peerDependencies": {
		"vue": "^3.4.0"
	},
	"peerDependenciesMeta": {
		"vue": {
			"optional": true
		}
	},
	"devDependencies": {
		"typescript": "^5.6.3",
		"vite": "5.4.21",
		"vue": "^3.4.0"
	}
}
