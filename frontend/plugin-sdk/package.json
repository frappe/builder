{
	"name": "frappe-builder-plugin-sdk",
	"version": "2.0.0",
	"description": "The build tooling for trusted Frappe Builder plugins. It has no runtime code: the editor serves its own modules.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frappe/builder.git",
		"directory": "frontend/plugin-sdk"
	},
	"type": "module",
	"bin": {
		"builder-plugin": "./bin/builder-plugin.js"
	},
	"files": [
		"bin",
		"create.js",
		"package.js",
		"src",
		"templates",
		"types",
		"vite.js",
		"README.md"
	],
	"types": "./types/builder.d.ts",
	"exports": {
		".": {
			"types": "./types/builder.d.ts"
		},
		"./vite": "./vite.js",
		"./package": "./package.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"package:plugin": "node ./bin/builder-plugin.js package"
	},
	"peerDependencies": {
		"vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
	}
}
